  {
    "id": "ng_e1810_route",
    "type": "function",
    "z": "tab_noise",
    "name": "E1810 → Device",
    "func": "const devices=flow.get('noise_devices')||{};const remote=String(msg.topic||'').split('/').pop();const key=Object.keys(devices).find(k=>devices[k].remote===remote);if(!key)return null;let d=msg.payload;if(typeof d==='string'){try{d=JSON.parse(d)}catch(e){return null}};const action=d&&d.action;if(!action)return null;const dev=devices[key],s=(flow.get('noise_states')||{})[key]||{};const gain=Number(s.gain);const mode=({White:0,Pink:1,Brown:2,Blue:3,white:0,pink:1,brown:2,blue:3})[s.mode]??Number(s.mode);const g=Number.isFinite(gain)?gain:10;const m=Number.isFinite(mode)?mode:0;let topic,payload;switch(action){case'toggle':topic=dev.base+'/mute/set';payload=String(String(s.mute||'').toUpperCase()==='ON'?'OFF':'ON');break;case'brightness_up_click':topic=dev.base+'/gain/set';payload=String(Math.min(19,g+1));break;case'brightness_up_hold':topic=dev.base+'/gain/set';payload=String(Math.min(19,g+2));break;case'brightness_down_click':topic=dev.base+'/gain/set';payload=String(Math.max(0,g-1));break;case'brightness_down_hold':topic=dev.base+'/gain/set';payload=String(Math.max(0,g-2));break;case'arrow_right_click':topic=dev.base+'/mode/set';payload=String((m+1)%4);break;case'arrow_left_click':topic=dev.base+'/mode/set';payload=String((m+3)%4);break;default:return null}msg.topic=topic;msg.payload=payload;msg.device=key;return msg;",
    "outputs": 1,
    "noerr": 0,
    "x": 410,
    "y": 620,
    "wires": [
      [
        "ng_mqtt_out"
      ]
    ]
  }
]