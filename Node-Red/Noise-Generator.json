  {
    "id": "ng_state_store",
    "type": "function",
    "z": "tab_noise",
    "name": "Store & Update UI",
    "func": "const m = msg.topic.match(/^([^/]+)\\/noise\\/([^/]+)$/);\\nif (!m) return null;\\nconst device = m[1];\\nconst kind = m[2];\\nconst states = flow.get('noise_states') || {};\\nstates[device] = states[device] || {};\\nstates[device][kind] = msg.payload;\\nstates[device].last = new Date().toISOString();\\nflow.set('noise_states', states);\\nif (device !== (flow.get('noise_selected_device') || 'hroom')) return null;\\nmsg.device = device;\\nmsg.kind = kind;\\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "x": 400,
    "y": 340,
    "wires": [
      [
        "ng_state_to_ui"
      ]
    ]
  },
  {
    "id": "ng_state_to_ui",
    "type": "function",
    "z": "tab_noise",
    "name": "State → Selected UI",
    "func": "const kind = msg.kind;\\nconst value = msg.payload;\\nif (kind === 'gain') {\\n  msg.payload = Number(value);\\n  msg.topic = 'gain';\\n} else if (kind === 'mode') {\\n  const map = {0:'white',1:'pink',2:'brown',3:'blue',White:'white',Pink:'pink',Brown:'brown',Blue:'blue'};\\n  msg.payload = map[value] || String(value).toLowerCase();\\n  msg.topic = 'mode';\\n} else if (kind === 'mute') {\\n  msg.payload = String(value).toUpperCase();\\n  msg.topic = 'mute';\\n} else if (kind === 'temperature') {\\n  const c = Number(value);\\n  if (!Number.isFinite(c)) return null;\\n  msg.payload = c.toFixed(2) + ' °C / ' + (c * 9 / 5 + 32).toFixed(2) + ' °F';\\n  msg.topic = 'temperature';\\n} else if (kind === 'heartbeat') {\\n  msg.payload = 'Last: ' + new Date().toLocaleString('en-US', {timeZone:'America/Denver'});\\n  msg.topic = 'heartbeat';\\n} else return null;\\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "x": 650,
    "y": 340,
    "wires": [
      [
        "ng_route_ui"
      ]
    ]
  },
  {
    "id": "ng_route_ui",
    "type": "function",
    "z": "tab_noise",
    "name": "Route UI State",
    "func": "switch (msg.topic) {\\n  case 'gain': return [msg,null,null,null,null];\\n  case 'mode': return [null,msg,null,null,null];\\n  case 'mute': return [null,null,msg,null,null];\\n  case 'temperature': return [null,null,null,msg,null];\\n  case 'heartbeat': return [null,null,null,null,msg];\\n  default: return null;\\n}",
    "outputs": 5,
    "noerr": 0,
    "x": 870,
    "y": 340,
    "wires": [
